      <aliases enabled='yes' />
      <column caption='Updated_Sales_Data' datatype='real' name='[Calculation_1019575263965184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Sales],0)' />
      </column>
      <column caption='Updated_sales_2' datatype='real' name='[Calculation_1019575264690177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Quantity]*[Unit Price]' />
      </column>
      <column caption='ifnull(segment)' datatype='string' name='[Calculation_1019575267799042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Segment],&quot;CS&quot;)' />
      </column>
      <column caption='Profit_ratio' datatype='real' name='[Calculation_1019575268286467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit]/[Sales]' />
      </column>
      <column caption='Discount_ratio' datatype='real' name='[Calculation_1019575268470788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Discount]/[Calculation_1019575264690177]' />
      </column>
      <column caption='previous_sales' datatype='real' name='[Calculation_1019575269015558]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales]-100' />
      </column>
      <column caption='Sales_growth' datatype='real' name='[Calculation_1019575269171207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1019575264690177]-[Calculation_1019575269015558]/[Calculation_1019575269015558]' />
      </column>
      <column caption='If_Condition' datatype='string' name='[Calculation_1019575269826568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sales]&gt;10000 THEN &quot;High Sales&quot; ELSE &quot;low sales&quot; END' />
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_1019575270690826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Segment] &#13;&#10;WHEN &quot;Consumer&quot; THEN &quot;C&quot;&#13;&#10;WHEN &quot;Corporate&quot; THEN &quot;CR&quot;&#13;&#10;WHEN &quot;Home Office&quot; THEN &quot;H&quot;&#13;&#10;ELSE &quot;other&quot; END' />
      </column>
      <column caption='CASE_category' datatype='string' name='[Calculation_1019575271456779]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Category]&#13;&#10;WHEN &quot;Clothing&quot; THEN &quot;Cl&quot;&#13;&#10;WHEN &quot;Sports&quot; THEN &quot;Sp&quot;&#13;&#10;WHEN &quot;Food &amp; Beverages&quot; THEN &quot;FB&quot;&#13;&#10;ELSE &quot;other&quot; END' />
      </column>
      <column caption='Date_Calculation' datatype='integer' name='[Calculation_1019575272157196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Order Date],[Ship Date])' />
      </column>
      <column caption='Year_calculation_today' datatype='integer' name='[Calculation_1019575272734733]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;,[Order Date],TODAY())' />
      </column>
      <column caption='Month_name' datatype='string' name='[Calculation_1019575273148430]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[Order Date])' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_1019575273558031]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;quarter&apos;,[Order Date])' />
      </column>
      <column caption='Running_total' datatype='real' name='[Calculation_1019575273881616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top values parameter ' datatype='boolean' name='[Calculation_1930795940982786]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Sales])&gt;= [Parameters].[Parameter 1930795940569089]' />
      </column>
      <column caption='Region selector' datatype='boolean' name='[Calculation_3164723154755587]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Region]=[Parameters].[Parameter 3164723154489346]' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
